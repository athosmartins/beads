#!/usr/bin/env bash
# Pre-commit hook: auto-format with gofmt and lint with golangci-lint.
# Installed via: git config core.hooksPath .githooks
# See also: make install (sets hooksPath automatically)

set -euo pipefail

# Only check staged Go files (Added, Copied, Modified). No early exit here:
# the beads section at the bottom must run for non-Go commits too.
staged_go_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.go')
if [ -n "$staged_go_files" ]; then
    # Pin the version to the one CI uses (.github/workflows/{pr,main}.yml). By default
    # golangci-lint is built from source so it is never a stale global binary; the only
    # pre-built binary accepted is one that is exactly this version and was built with a Go
    # at least as new as go.mod's (pinned_lint_bin below), and every doubt falls back to this.
    GOLANGCI_LINT="go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.10.1"

    # Build it with the repo's own Go, the way CI does. In CI, actions/setup-go
    # installs the go.mod version and exports GOTOOLCHAIN=local. Locally
    # GOTOOLCHAIN defaults to "auto", and for a pkg@version build that honours
    # golangci-lint's own toolchain directive instead: it downgrades to
    # go1.25.12, which then refuses this repo's newer go directive at config
    # load ("the Go language version (go1.25) used to build golangci-lint is
    # lower than the targeted Go version") and fails every Go commit. Pinning to
    # the go directive reproduces CI's resolution on any host toolchain.
    go_toolchain="go$(awk '$1 == "go" { print $2; exit }' go.mod)"
    if [ "$go_toolchain" = "go" ]; then
        echo >&2 "pre-commit: no go directive in go.mod; cannot pin the lint toolchain"
        exit 1
    fi

    # Auto-format and re-stage
    echo "$staged_go_files" | xargs gofmt -w
    echo "$staged_go_files" | xargs git add

    # --- ga-f43ofc5 (port of ga-opj0hnt): the lint runs under the city's heavy-guard -----------
    # 31/10: a commit in this repo started a cold `go run golangci-lint@v2.10.1` on the mini and
    # the free disk went 7.3 -> 5.0 GB in 4 minutes (Dolt is at risk of ENOSPC under ~5 GB;
    # 17/10 outage, ga-vln2py). So the lint goes through scripts/heavy-guard.sh of the city:
    # a floor on the free disk before it starts, and a watch on the disk while it runs.
    #   - pre-built linter (pinned_lint_bin below): label "pre-commit golangci-lint" = the
    #     "heavy" floor (6 GB); the linter itself is not built;
    #   - fallback `go run`: label "go-build ..." = the Go-class floor (13 GB). On the mini that
    #     means "refused" unless the pre-built linter qualifies. That is intended: it is the case
    #     that filled the disk. The refusal says what to do (free disk / build the linter).
    # The guard's exit code is the hook's exit code (75 disk low, 76 disk unknown, 78 stopped by
    # the watch, 79 busy), so a refusal is never mistaken for "the linter found issues" (1).
    GOLANGCI_LINT_WANT="${GOLANGCI_LINT##*@v}"   # the pinned version comes only from GOLANGCI_LINT above

    # Prints the path of a pre-built golangci-lint that is safe to use, or nothing.
    # Safe = executable, exactly the pinned version, and built with a Go at least as new as the
    # `go` directive of go.mod (an older build panics on this module's code).
    # Every doubt prints nothing: the caller then takes the guarded `go run`, never an unchecked binary.
    pinned_lint_bin() {
        local bin mod_go ver_line have_ver built_go oldest re
        bin="${GOLANGCI_LINT_BIN:-${HOME:-/nonexistent}/go/bin/golangci-lint}"
        # vazio → no such file; falhou/ilegível → not executable: both print nothing (go run fallback)
        [ -x "$bin" ] || return 0
        # vazio → no `go` directive; falhou/ilegível → go.mod unreadable: both print nothing (go run fallback)
        mod_go=$(awk '$1 == "go" { print $2; exit }' go.mod 2>/dev/null) || mod_go=""
        [ -n "$mod_go" ] || return 0
        # vazio → no output; falhou/ilegível → --version fails or is not the usual line: nothing (go run fallback)
        ver_line=$("$bin" --version 2>/dev/null) || ver_line=""
        re='^golangci-lint has version ([0-9][0-9.]*) built with go([0-9][0-9.]*)'
        [[ "$ver_line" =~ $re ]] || return 0
        have_ver="${BASH_REMATCH[1]}"
        built_go="${BASH_REMATCH[2]}"
        [ "$have_ver" = "$GOLANGCI_LINT_WANT" ] || return 0
        # vazio → sort printed nothing; falhou/ilegível → sort -V missing: oldest is empty, so no match (go run fallback)
        oldest=$(printf '%s\n%s\n' "$mod_go" "$built_go" | sort -V | sed -n 1p) || oldest=""
        [ "$oldest" = "$mod_go" ] || return 0   # built_go older than go.mod's directive
        echo "$bin"
    }

    HEAVY_GUARD="${GC_CITY_PATH:-/Users/athos/gt/.gascity-gastown-hq}/scripts/heavy-guard.sh"
    if [ ! -x "$HEAVY_GUARD" ]; then
        # No guard on this machine (CI, a laptop outside the city): skip, loudly. CI still lints.
        echo >&2 "pre-commit: golangci-lint SKIPPED — heavy-guard not found at $HEAVY_GUARD, so the free disk was not checked. CI still lints; set GC_CITY_PATH to the city to lint here."
    else
        # vazio → no usable pre-built linter (go run fallback); falhou → same (the function never fails)
        lint_bin=$(pinned_lint_bin) || lint_bin=""
        # Lint changed code with auto-fix; block on remaining issues.
        # CGO_ENABLED=0 avoids typecheck failures from CGO-only dependencies
        # (e.g., dolthub/go-icu-regex) that require system headers not always present.
        # GOTOOLCHAIN="$go_toolchain" (see above) is kept on both paths: it also decides which
        # `go` the pre-built linter shells out to.
        # --max-disk-drop-mb: the watch stops the step when the free disk falls that much while it runs.
        # 2048 MB (pre-built) is below the 2.3 GB the 31/10 incident lost while also compiling the
        # linter; a cold typecheck that hits it is stopped (78) and keeps what it already cached for the retry.
        if [ -n "$lint_bin" ]; then
            CGO_ENABLED=0 GOTOOLCHAIN="$go_toolchain" "$HEAVY_GUARD" --what "pre-commit golangci-lint" --max-disk-drop-mb 2048 -- \
                "$lint_bin" run --new-from-rev=HEAD --fix || exit $?
        else
            CGO_ENABLED=0 GOTOOLCHAIN="$go_toolchain" "$HEAVY_GUARD" --what "go-build golangci-lint" --max-disk-drop-mb 6144 -- \
                $GOLANGCI_LINT run --new-from-rev=HEAD --fix || exit $?
        fi
    fi

    # Re-stage any auto-fixes from the linter
    echo "$staged_go_files" | xargs git add
fi

# --- BEGIN BEADS INTEGRATION v1.3.0 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  case "$_bd_timeout" in
    *[!0-9]*|'') _bd_timeout_invalid=1 ;;
    *[1-9]*) _bd_timeout_invalid=0 ;;
    *) _bd_timeout_invalid=1 ;;
  esac
  if [ "$_bd_timeout_invalid" -eq 1 ]; then
    echo >&2 "beads: invalid BEADS_HOOK_TIMEOUT; using 300 seconds"
    _bd_timeout=300
  fi
  _bd_timeout_backend=none
  _bd_timeout_command=
  for _bd_timeout_candidate in timeout gtimeout; do
    if command -v "$_bd_timeout_candidate" >/dev/null 2>&1; then
      if _bd_timeout_version="$("$_bd_timeout_candidate" --version 2>/dev/null)"; then
        case "$_bd_timeout_version" in
          "timeout (GNU coreutils) "*) _bd_timeout_command=$_bd_timeout_candidate; break ;;
        esac
      fi
    fi
  done
  if [ -n "$_bd_timeout_command" ]; then
    _bd_timeout_backend=coreutils
    if "$_bd_timeout_command" -- "$_bd_timeout" bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  elif command -v perl >/dev/null 2>&1; then
    _bd_timeout_backend=perl
    if perl -e 'alarm shift; exec @ARGV' -- "$_bd_timeout" bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    if bd hooks run pre-commit "$@"; then
      _bd_exit=0
    else
      _bd_exit=$?
    fi
  fi
  if { [ "$_bd_timeout_backend" = coreutils ] && [ "$_bd_exit" -eq 124 ]; } || { [ "$_bd_timeout_backend" = perl ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
